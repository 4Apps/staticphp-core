# Keep the published package to what an application actually loads. These are all present
# in the repository and in a --prefer-source install; they are stripped from the dist
# archive that `composer require` normally fetches.
#
# The directory entry carries the attribute and everything under it goes with it, so
# `git check-attr export-ignore -- tests/autoload.php` reports "unspecified" while
# `git archive` still leaves the file out. Verify with `git archive HEAD | tar t`.
/tests/            export-ignore
/scripts/          export-ignore
/docker/           export-ignore
/.github/          export-ignore
/docker-compose.yml export-ignore
/phpunit.xml       export-ignore
/phpcs.xml         export-ignore
/.gitattributes    export-ignore
/.gitignore        export-ignore
/.env.example      export-ignore
/CONTRIBUTING.md   export-ignore

# Release input rather than runtime data. A consumer that wants the installed version asks
# composer for it: Composer\InstalledVersions::getPrettyVersion('4apps/staticphp-core')
/.version          export-ignore

# A library's lock file pins its own dev tooling and is never consulted by a consumer
/composer.lock     export-ignore
