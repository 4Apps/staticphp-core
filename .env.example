# Copy to .env before the first `docker compose build develop`.
#
# The dev container mounts the working tree and runs as a non-root user. If that user's ids
# do not match yours, composer cannot write vendor/ into the mount.
#
#   printf 'LOCAL_USER_ID=%s\nLOCAL_GROUP_ID=%s\n' "$(id -u)" "$(id -g)" > .env

LOCAL_USER_ID=1000
LOCAL_GROUP_ID=1000

GIT_NAME=
GIT_EMAIL=
