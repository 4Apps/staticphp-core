{
    "name": "4apps/staticphp-core",
    "description": "A lightweight PHP framework",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Gints Murans",
            "email": "gm@gm.lv"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "squizlabs/php_codesniffer": "^4.0",
        "twig/twig": "^3.0"
    },
    "suggest": {
        "twig/twig": "Template engine for the view layer. Leave it out of an api-only application - composer's files autoload is eager, so twig and the symfony polyfills it pulls in load eight files on every request whether or not a template is ever rendered."
    },
    "autoload": {
        "psr-4": {
            "StaticPHP\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "StaticPHP\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "lint": "@php vendor/bin/phpcs --standard=phpcs.xml src tests"
    }
}
