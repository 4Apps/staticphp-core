includes:
    - phpstan-baseline.neon
    # Teaches analysis that assertNotNull(), assertInstanceOf() and friends narrow the
    # types they assert, so a test does not have to restate what it just asserted
    - vendor/phpstan/phpstan-phpunit/extension.neon

parameters:
    paths:
        - src
        - tests

    # phpstan-baseline.neon is empty and stays that way: every finding is a real one. Fix
    # what analysis reports rather than regenerating the baseline with
    # `composer stan-baseline` to make a new finding go away.
    level: 9

    # The application may define these global functions; the framework only ever calls them
    # behind function_exists(). Declaring them here is what lets analysis see their shape.
    stubFiles:
        - phpstan/app-hooks.stub

    ignoreErrors:
        # SessionsMongoDb is one of several interchangeable session backends and the only one
        # needing an extension that is not in require. An install that wants it pulls in
        # mongodb/mongodb; every other install must not be made to. Without the package its
        # classes cannot be named in a type either, so the driver handles stay mixed.
        -
            message: '#Instantiated class MongoDB\\Client not found#'
            path: src/Utils/Models/Sessions/SessionsMongoDb.php
        -
            message: '#(Cannot call method [a-zA-Z]+\(\)|Cannot access property \$[a-zA-Z_]+) on mixed#'
            path: src/Utils/Models/Sessions/SessionsMongoDb.php

        # Both factories return null when ICU rejects the locale or the pattern - confirmed
        # against php 8.4 - but the bundled stubs type them as never-null. The null checks
        # they flag are the only thing standing between a bad pattern and a fatal, so this
        # is the stub being wrong rather than the code.
        -
            message: '#Strict comparison using === between (Message|Number)Formatter and null will always evaluate to false#'
            path: src/Utils/Models/Translation/Formatter.php
